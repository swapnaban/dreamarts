{
  "routes": [
    {
      "route": "/",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/api/manage/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN"
  }
}