{
  "routes": [
    {
      "route": "/",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/api/manage/*",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/robots.txt",
      "/sitemap.xml",
      "/favicon.svg",
      "/og-image.jpg"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN"
  }
}